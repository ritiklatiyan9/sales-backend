# ── booking-api environment ──
# Serves both the REST API and the React SPA (no separate frontend service).
# Shares the SAME Postgres / Redis / JWT / S3 as the accounting backend.
PORT=8000

# Postgres (same DB as accounting — additive tables only)
DB_HOST=your-neon-host
DB_PORT=5432
DB_NAME=rgaccount
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_SSL=true
# Certificate validation is required in production. Supply a private CA if needed.
DB_SSL_CA=

# JWT — MUST match the accounting backend so tokens are interchangeable
# Generate TWO different values with `openssl rand -hex 32` (run twice).
# Configure each matching value on BOTH backends and redeploy together.
# Rotation signs users out. Never paste keys into chat or a VITE_ variable.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-bytes

# My Real Assets mobile app, hosted on this Bookings API. Explicit production opt-in.
# Independent of CLIENT_PORTAL_ENABLED (the older web portal).
MOBILE_PORTAL_ENABLED=true
# Optional dedicated random secret (at least 32 characters); absent uses a domain-
# separated key derived from the strong JWT_ACCESS_SECRET. Never put it in Flutter.
MOBILE_PORTAL_SECRET=

# Google Sign-In (Firebase) — path to the Firebase Admin service-account key.
# The frontend's Firebase popup sends an ID token that this key verifies. Only emails
# that already exist on a users row may sign in with Google (no self-signup).
FIREBASE_SERVICE_ACCOUNT=secrets/firebase-service-account.json
# Optional fallback: verify plain Google Identity Services tokens against this
# OAuth 2.0 Web client ID instead (used only if the Firebase key is absent).
GOOGLE_CLIENT_ID=

# ── Admin login OTP (Nodemailer) ──
# When LOGIN_OTP_ENABLED=true, super_admin/admin/sub_admin logins require a
# 6-digit code emailed to the account's address (agents stay single-step).
# Gmail: host smtp.gmail.com, port 587, and an App Password (not the account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: display sender, e.g. "Defence Garden ERP <no-reply@defencegarden.in>"
SMTP_FROM=
# Leave false until SMTP credentials have been verified. When false, admin
# password and Google login do not depend on email delivery.
LOGIN_OTP_ENABLED=false

# Receipt/agreement QR verification — MUST match the accounting backend (shared HMAC).
RECEIPT_VERIFY_SECRET=
# Public verify page for booking/agreement receipt QRs (accounting frontend).
PUBLIC_VERIFY_URL=http://localhost:5173/verify-receipt
# Public verify page for DRAW registration/slip QRs (this booking frontend).
DRAW_PUBLIC_VERIFY_URL=http://localhost:5173/verify/draw

# S3 (same bucket as accounting). In production set this so OCR can read uploads; in local
# dev the on-disk fallback works because OCR now runs inside this same process.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# ── WhatsApp customer notifications (AWS End User Messaging Social) ──
# Registered / KYC verified / booking made / allotted. Leave false until the templates are
# APPROVED (npm run whatsapp -- templates). Uses the AWS keys above; that IAM user needs the
# social-messaging policy in README. Server-side only, never in VITE_ variables. Also set
# WHATSAPP_ENABLED=true in rgaccountbackend, where most KYC verifications happen.
WHATSAPP_ENABLED=false
# AWS console > End User Messaging Social > WhatsApp > your number: phone-number-id-<32 chars>
WHATSAPP_PHONE_NUMBER_ID=
# Region where the WhatsApp Business Account is linked (defaults to AWS_REGION)
WHATSAPP_AWS_REGION=ap-south-1
# Keys of the AWS account that owns the WhatsApp number (Mount Reality). Empty = use the S3 keys above.
WHATSAPP_AWS_ACCESS_KEY_ID=
WHATSAPP_AWS_SECRET_ACCESS_KEY=
# Private S3 bucket in that same account and region, for PDFs sent on WhatsApp (receipts).
WHATSAPP_MEDIA_BUCKET=defence-garden-whatsapp-044986460213
# WhatsApp Marketing: offers sent per rolling 24 hours (Meta allows an unverified business
# 250 different people a day in total; 200 leaves room for booking/KYC updates).
WHATSAPP_MARKETING_DAILY_LIMIT=200
# Language the templates were approved in; Meta Graph API version (AWS docs' v20.0 is retired)
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_META_API_VERSION=v23.0

# CORS origins for the booking-ui SPA (explicit origins only; wildcard is rejected in production)
CORS_ORIGIN=https://sales-dg-frontend.vercel.app,https://www.dgbooking.com,https://dgbooking.com

# ── OCR (in-process, OpenRouter only) ──
# Set on the Booking API host (Render), never in VITE_ variables or the browser.
# Mistral/Groq keys are no longer used by the current backend.
OPENROUTER_API_KEY=
OPENROUTER_OCR_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_OCR_FALLBACK_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_OCR_TIMEOUT_MS=60000
OPENROUTER_PDF_ENGINE=native
OPENROUTER_APP_URL=https://dgbooking.com
OPENROUTER_APP_NAME=Defence Garden Booking ERP
# OCR is intentionally single-flight to protect provider rate limits.
OCR_CONCURRENCY=1

# Public website integration. Explicitly bind to OM ASSOCIATES (confirmed site id).
WEBSITE_SITE_ID=5
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Stable secret for opaque retry/recovery tokens; keep server-side and unchanged.
WEBSITE_REQUEST_TOKEN_SECRET=
# Configure the matching secret + /public/website/webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
# Optional known reverse-proxy subnet(s), never trust forwarding headers globally.
TRUST_PROXY=

# Client-only JWT realm. Generate independent random secrets; never expose through VITE_.
CLIENT_PORTAL_SECRET=
# Stable identity matching key: preserve independently from JWT signing key rotations.
CLIENT_PORTAL_IDENTITY_SECRET=

# Client login and all client-portal APIs are paused.
CLIENT_PORTAL_ENABLED=false

# My Real Assets notifications. Use a Firebase service account for the SAME
# project as the mobile google-services.json. Keep JSON secrets server-side.
MRA_FCM_ENABLED=false
# MRA_FCM_SERVICE_ACCOUNT_FILE=/etc/secrets/my-real-assets-fcm.json
# MRA_FCM_SERVICE_ACCOUNT_B64=<base64-encoded-service-account-json>
